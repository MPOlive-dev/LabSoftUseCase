@model AppTask.Models.Incidente

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Incidente</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form action="/Incidente/Create" method="post">
            @Html.AntiForgeryToken()
            <div id="validation-summary" class="text-danger"></div>
            <div class="form-group">
                <label for="DescricaoProblema" class="control-label"></label>
                <input name="DescricaoProblema" id="DescricaoProblema" class="form-control" />
                <span id="erro-DescricaoProblema" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label for="DataIncidente" class="control-label"></label>
                <input name="DataIncidente" id="DataIncidente" class="form-control" />
                <span id="erro-DataIncidente" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label for="Solucao" class="control-label"></label>
                <input name="Solucao" id="Solucao" class="form-control" />
                <span id="erro-Solucao" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label for="Resolvido" class="control-label"></label>
                <input name="Resolvido" id="Resolvido" class="form-control" />
                <span id="erro-Resolvido" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a href="/Incidente/Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

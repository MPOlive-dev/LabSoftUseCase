@model AppTask.Models.Departamento

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Departamento</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form action="/Departamento/Create" method="post">
            @Html.AntiForgeryToken()
            <div id="validation-summary" class="text-danger"></div>
            <div class="form-group">
                <label for="Descricao" class="control-label"></label>
                <input name="Descricao" id="Descricao" class="form-control" />
                <span id="erro-Descricao" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label for="Ativo" class="control-label"></label>
                <input name="Ativo" id="Ativo" class="form-control" />
                <span id="erro-Ativo" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a href="/Departamento/Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

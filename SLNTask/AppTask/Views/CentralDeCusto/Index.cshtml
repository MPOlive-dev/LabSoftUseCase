@model IEnumerable<AppTask.Models.CentralDeCusto>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a href="/CentralDeCusto/Create" class="btn btn-success text-white">Create New</a>
</p>
<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.NomeCentral)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ValorMetaAnual)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.NomeCentral)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ValorMetaAnual)
            </td>
            <td>
                    <a href="/CentralDeCusto/Edit/@item.Codigo">Edit</a> |
                    <a href="/CentralDeCusto/Details/@item.Codigo">Details</a> |
                    <button type="button" class="btn btn-danger btn-sm text-white"
                            data-bs-toggle="modal"
                            data-bs-target="#deleteModal"
                            data-id="@item.Codigo"
                            data-descricao="@item.Codigo">
                        Delete
                    </button>
            </td>
        </tr>
}
    </tbody>
</table>
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">Confirmação de Exclusão</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Deseja realmente excluir a tarefa: <strong id="tarefaDescricao"></strong>?
            </div>
            <div class="modal-footer">
                <button type="button" class="modal-btn-cancel btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <!-- Formulário que dispara o POST de Delete para a Controller -->
                <form id="deleteForm" method="post" action="">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Sim, Excluir</button>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        // Captura o evento de abertura do modal e preenche os dados dinamicamente
        var deleteModal = document.getElementById('deleteModal');
        deleteModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var id = button.getAttribute('data-id');
            var descricao = button.getAttribute('data-descricao');

            var modalDescricaoSpan = deleteModal.querySelector('#tarefaDescricao');
            modalDescricaoSpan.textContent = descricao;

            var deleteForm = deleteModal.querySelector('#deleteForm');
            deleteForm.action = '/Tarefa/Delete/' + id;
        });
    </script>
}
